---
import Base from '../layouts/Base.astro';
import Film from '../components/Film.astro';
import { WA_DEFAULT } from '../data/site';
---
<Base title="Pagina nu există | ADSNOW" description="Pagina pe care o cauți nu mai există sau a fost mutată." path="/404">
  <section class="phero" style="min-height:100svh">
    <Film name="harta" eager />
    <div class="wrap phero-in">
      <h1>Pagina asta nu e pe hartă.</h1>
      <p class="lead">Linkul e greșit sau pagina a fost mutată.</p>
      <div class="btn-row">
        <a href="/" class="btn btn-coral">Mergi la prima pagină</a>
        <a href={WA_DEFAULT} class="btn btn-ghost-light" target="_blank" rel="noopener" data-track="whatsapp">Scrie-mi pe WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
