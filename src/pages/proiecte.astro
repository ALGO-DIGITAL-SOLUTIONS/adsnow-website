---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Related from '../components/Related.astro';
import { SITE, BUSINESS_ID, breadcrumb } from '../data/site';

const path = '/proiecte';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE}${path}#webpage`,
    name: 'Proiecte și studii de caz ADSNOW',
    url: `${SITE}${path}`,
    about: { '@id': BUSINESS_ID },
    inLanguage: 'ro-RO',
  },
  breadcrumb([{ name: 'Proiecte', path }]),
];
---
<Base
  title="Proiecte și studii de caz: site-uri, SEO local, video · ADSNOW"
  ogTitle="Proiecte și studii de caz ADSNOW"
  description="Studii de caz cu cifre: locul 1 pe Google Maps pentru Armour Glass, +45% vizite din Google pentru Albastru Infinit, 451 de urmăritori reali pentru Ozone Residence. Plus site-urile livrate."
  path={path}
  schema={schema}
>
  <PageHero
    crumb="Proiecte"
    title="Proiecte și studii de caz"
    lead="Cifrele vin direct din Google și Instagram, verificate în noiembrie 2026. Toate proiectele sunt live, intră pe ele."
  />

  <section class="section-muted section-padding" style="padding-top:64px;">
    <div class="container">
      <span class="eyebrow fade-in">Studii de caz</span>
      <h2 class="section-title fade-in">Ce s-a schimbat după ce am lucrat împreună</h2>
      <CaseStudies detailed />
    </div>
  </section>

  <section class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Site-uri</span>
      <h2 class="section-title fade-in">Site-uri pe care le poți încerca acum</h2>
      <ProjectGrid filter="site" />
    </div>
  </section>

  <section class="section-muted section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Google Maps, Instagram și video</span>
      <h2 class="section-title fade-in">Clienți pe care îi găsești pe Google și Instagram</h2>
      <ProjectGrid filter={['seo', 'social', 'content']} />
      <Related current={path} />
    </div>
  </section>

  <CtaFinal />
</Base>
