---
import Base from '../layouts/Base.astro';
import EndCta from '../components/EndCta.astro';
import { PROOF, PROJECTS, breadcrumb } from '../data/site';

const path = '/proiecte';
const a = PROOF.armour, b = PROOF.albastru, o = PROOF.ozone;
---
<Base title="Proiecte: site-uri, Google Maps și video din Brașov | ADSNOW" description="Proiecte reale, live, cu cifre verificate în Google: Armour Glass în top 3 pe hartă, Albastru Infinit pe prima pagină, Ozone Residence de la zero." path={path} schema={[breadcrumb([{ name: 'Proiecte', path }])]} ogImage="/assets/og/proiecte.jpg" dark={false}>
  <section class="sec" style="padding-top:clamp(140px,16vw,200px)">
    <div class="wrap">
      <div class="sec-head">
        <h1 style="font-size:clamp(48px,6.4vw,96px)">Proiecte pe care le poți verifica</h1>
        <p class="lead muted">Cifre verificate în noiembrie 2026, direct din Google și din conturile clienților. Toate proiectele sunt live.</p>
      </div>
      <div class="cases">
        <article class="case">
          <div><span class="proof-big">{a.big}</span><p class="proof-line" style="color:var(--indigo)">{a.line}</p></div>
          <div>
            <p class="who">{a.client}, înlocuire de parbrize</p>
            <p style="margin-top:12px">{a.detail}</p>
            <ol class="pack" style="box-shadow:inset 0 0 0 1px var(--line);margin-top:20px" aria-label="Primele trei rezultate pe hartă">{a.pack.map((m) => <li class:list={{ us: m.us }}><span>{m.name}</span><span class="r">{m.rating} <b aria-hidden="true">★</b> ({m.reviews})</span></li>)}</ol>
            <p style="margin-top:20px"><a href={a.url} class="textlink" target="_blank" rel="noopener">armourglass-parbrize.ro</a></p>
          </div>
        </article>
        <article class="case">
          <div><span class="proof-big">{b.big}</span><p class="proof-line" style="color:var(--indigo)">{b.line}</p></div>
          <div>
            <p class="who">{b.client}, cabinet de psihoterapie</p>
            <p style="margin-top:12px">{b.detail}</p>
            <p style="margin-top:20px"><a href={b.url} class="textlink" target="_blank" rel="noopener">albastruinfinit.ro</a></p>
          </div>
        </article>
        <article class="case">
          <div><span class="proof-big" style="font-size:clamp(44px,4.4vw,72px)">{o.big}</span><p class="proof-line" style="color:var(--indigo)">{o.line}</p></div>
          <div>
            <p class="who">{o.client}</p>
            <p style="margin-top:12px">{o.detail}</p>
            <p style="margin-top:20px"><a href={o.url} class="textlink" target="_blank" rel="noopener">ozoneresidence.ro</a></p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sec sec-mist">
    <div class="wrap">
      <div class="sec-head"><h2>Site-uri pe care le poți deschide acum</h2><p class="lead muted">Deschide-le de pe telefon, cum le deschid și clienții lor.</p></div>
      <div class="shots">
        {PROJECTS.map((p) => (
          <div class="shot"><a href={p.url} target="_blank" rel="noopener"><img src={p.img} alt={`Site-ul ${p.name}`} width="1200" height="750" loading="lazy"/><strong>{p.name}</strong><span>{p.type}</span></a></div>
        ))}
      </div>
    </div>
  </section>

  <EndCta />
</Base>
