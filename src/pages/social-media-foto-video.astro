---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Effects from '../components/Effects.astro';
import Steps from '../components/Steps.astro';
import Reels from '../components/Reels.astro';
import Faq from '../components/Faq.astro';
import PriceLine from '../components/PriceLine.astro';
import EndCta from '../components/EndCta.astro';
import { breadcrumb, faqSchema, SITE, BUSINESS_ID } from '../data/site';

const path = '/social-media-foto-video';
const FAQ = [
  { q: 'Cine filmează?', a: 'Eu, la tine, în Brașov și până la o oră de mers. Tot ce apare în postările tale e filmat la tine, cu oamenii și lucrurile tale.' },
  { q: 'Pot lua doar câteva video-uri, fără abonament?', a: 'Da. Poți lua o zi de filmare sau câteva reels pe bucată. Abonamentul are sens când vrei să postezi în fiecare săptămână.' },
  { q: 'Aprob eu postările înainte să apară?', a: 'Da. Primești planul lunar înainte, cu textele și materialele, și nimic nu se publică fără acordul tău.' },
  { q: 'Faci și reclame?', a: 'Da, pe Facebook și Instagram. Întâi ne asigurăm că oferta și site-ul sunt pregătite, ca fiecare leu dat pe reclame să aducă ceva. Bugetul de reclame îl plătești direct către Meta și îl vezi în contul tău.' },
];
const schema = [
  { '@type': 'Service', name: 'Video și social media', serviceType: 'Video production', provider: { '@id': BUSINESS_ID }, areaServed: 'Brașov', url: `${SITE}${path}` },
  breadcrumb([{ name: 'Video', path }]),
  faqSchema(FAQ),
];
---
<Base title="Reels și video de prezentare în Brașov | ADSNOW" description="Vin la tine, filmez și montez reels și video de prezentare. Clienții te cunosc înainte să te sune, iar tu ai material pentru toate rețelele." path={path} schema={schema} ogImage="/assets/og/social-media-foto-video.jpg" preload="/video/video.webp">
  <ServiceHero crumb="Video" film="video" title="Oamenii te văd lucrând înainte să intre pe ușă" lead="Vin la tine, filmez și montez reels și video de prezentare, gata de postat. Tu lucrezi ca de obicei, eu am grijă de restul." />

  <Effects title="Ce se schimbă pentru tine" items={[
    { h: 'Te cunosc înainte să te sune', p: 'Un client nou care te-a văzut lucrând are deja încredere. Vine mai ușor și negociază mai puțin.' },
    { h: 'O zi de filmare, o lună de postări', p: 'Din aceeași zi ies reels, poze și un video de prezentare, pentru Instagram, TikTok, site și reclame.' },
    { h: 'Postezi constant, fără stres', p: 'Primești planul, aprobi, iar postările apar la ore bune. Nu mai stai tu cu telefonul în mână.' },
  ]} />

  <section class="sec-tight sec-night on-dark" aria-labelledby="reels-h">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:40px"><h2 id="reels-h">Filmate la clienți, montate de mine</h2><p class="lead muted">Atinge un video ca să pornești sunetul.</p></div>
      <Reels />
    </div>
  </section>

  <Steps title="Cum lucrez" items={[
    { when: 'Înainte', h: 'Plănuim ce filmăm', p: 'Ce vrei să afle oamenii despre tine și ce întrebări primești des. Din asta ies ideile de video.' },
    { when: 'Ziua de filmare', h: 'Vin la tine', p: 'Până la șase ore, cu lumină și sunet. Tu lucrezi ca de obicei, eu prind momentele bune.' },
    { when: 'În aceeași săptămână', h: 'Montaj și subtitrări', p: 'Montaj, culoare, subtitrări și muzică, în format vertical și orizontal.' },
    { when: 'Lunar', h: 'Postare și raport', p: 'Postez pe conturile tale după planul aprobat și îți spun ce a mers.' },
  ]} />

  <PriceLine anchor="video" />
  <Faq items={FAQ} title="Întrebări despre video" />
  <EndCta message="Bună, Alex! Aș vrea video pentru afacerea mea: " />
</Base>
