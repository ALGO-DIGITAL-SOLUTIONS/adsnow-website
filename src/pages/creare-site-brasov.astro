---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Effects from '../components/Effects.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import PriceLine from '../components/PriceLine.astro';
import EndCta from '../components/EndCta.astro';
import { PROJECTS, breadcrumb, faqSchema, SITE, BUSINESS_ID } from '../data/site';

const path = '/creare-site-brasov';
const FAQ = [
  { q: 'Chiar e gata în 10 zile?', a: 'Da, în 10 zile lucrătoare de când primesc logo-ul, câteva poze și informațiile de bază. Textele le scriu eu. Din ziua a treia vezi site-ul pe un link de test, iar fiecare rundă de modificări durează cel mult două zile.' },
  { q: 'De ce se face atât de repede?', a: 'Pentru că omul cu care vorbești e același care face site-ul, deci nu se pierde timp între oameni, și pentru că lucrez după un proces rafinat de la proiect la proiect.' },
  { q: 'Pot să modific eu site-ul după lansare?', a: 'Da. Îți arăt într-o oră cum schimbi un text, o poză sau un preț și primești instrucțiuni scrise. Dacă nu vrei să te ocupi, pot ține eu site-ul la zi lunar.' },
  { q: 'Am deja un site. Merită unul nou?', a: 'Merită când cel vechi arată prost pe telefon, se încarcă greu sau nu mai spune ce faci azi. Dacă site-ul tău e în regulă și pur și simplu nu ajunge nimeni pe el, îți spun asta din primul mesaj și ne uităm la Google Maps.' },
  { q: 'Faci și magazine online?', a: 'Da, magazine mici, de până la 50–100 de produse, cu plată cu cardul sau ramburs. Pentru magazine mari, legate de stocuri și facturare, îți recomand o echipă specializată.' },
];
const schema = [
  { '@type': 'Service', name: 'Creare site de prezentare', serviceType: 'Web design', provider: { '@id': BUSINESS_ID }, areaServed: 'Brașov', url: `${SITE}${path}` },
  breadcrumb([{ name: 'Site-uri', path }]),
  faqSchema(FAQ),
];
---
<Base title="Creare site Brașov, gata în 10 zile | ADSNOW" description="Site de prezentare făcut întâi pentru telefon, cu textele scrise de mine și legat de Google Maps. Gata în 10 zile lucrătoare, cu parolele la tine." path={path} schema={schema} ogImage="/assets/og/creare-site-brasov.jpg" preload="/video/site.webp">
  <ServiceHero crumb="Site-uri" film="site" title="Te caută cineva și află în cinci secunde ce faci" lead="Un site făcut întâi pentru telefon, cu textele scrise de mine, gata în 10 zile. Clientul vede ce faci, cât costă și cum te sună, fără să caute." />

  <Effects title="Ce se schimbă pentru tine" items={[
    { h: 'Omul te sună, nu pleacă', p: 'Butoane de telefon și WhatsApp în fiecare ecran, programul și adresa la vedere. Cine a ajuns pe site nu mai trebuie să caute cum te contactează.' },
    { h: 'Arăți ca firma pe care o meriți', p: 'Design gândit pentru afacerea ta, poze bune și texte scrise cu cuvintele clienților tăi. Pe telefon arată la fel de bine ca pe calculator.' },
    { h: 'Google știe ce faci', p: 'Fiecare serviciu are pagina lui, site-ul e legat de fișa ta de pe Google Maps și se încarcă repede. Așa urci mai ușor în căutări.' },
  ]} />

  <Steps title="Cum arată cele 10 zile" lead="Termenul pornește când am materialele. Tu răspunzi la mesaje, eu fac restul." items={[
    { when: 'Ziua 1', h: 'Vorbim și primești lista', p: 'Logo, poze, servicii, program. Dacă nu ai poze bune, le facem într-o zi de filmare.' },
    { when: 'Zilele 1–3', h: 'Scriu și construiesc', p: 'Textele și prima variantă. Din ziua a treia o vezi pe telefon, pe un link de test.' },
    { when: 'Zilele 4–8', h: 'Îl ajustăm împreună', p: 'Îmi scrii ce schimbăm, eu modific în cel mult două zile. De obicei ajung două runde.' },
    { when: 'Zilele 9–10', h: 'E live', p: 'Îl pun pe domeniul tău, îl leg de Google, primești parolele și îți arăt cum se folosește.' },
  ]} />

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>Site-uri pe care le poți deschide acum</h2><p class="lead muted">Toate sunt live. Deschide-le de pe telefon, cum le deschid și clienții lor.</p></div>
      <div class="shots">
        {PROJECTS.filter((p) => p.type.includes('Site')).map((p) => (
          <div class="shot"><a href={p.url} target="_blank" rel="noopener"><img src={p.img} alt={`Site-ul ${p.name}`} width="1200" height="750" loading="lazy"/><strong>{p.name}</strong><span>{p.type}</span></a></div>
        ))}
      </div>
    </div>
  </section>

  <PriceLine anchor="site-uri" />
  <Faq items={FAQ} title="Întrebări despre site-uri" />
  <EndCta message="Bună, Alex! Aș vrea un site. Afacerea mea: " />
</Base>
