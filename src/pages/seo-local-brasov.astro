---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Related from '../components/Related.astro';
import PriceTable from '../components/PriceTable.astro';
import CaseStudies from '../components/CaseStudies.astro';
import { SEO } from '../data/pricing';
import { SITE, BUSINESS_ID, breadcrumb, faqSchema } from '../data/site';

const path = '/seo-local-brasov';

const faq = [
  {
    q: 'Cât costă SEO local?',
    a: 'Setup-ul fișei Google costă 600 lei, o singură dată. Apoi ai două variante lunare: Maps Esențial la 390 lei/lună (postări pe fișă, răspunsuri la recenzii, poze noi, raport) sau SEO local complet la 890 lei/lună (în plus, o pagină sau un articol local pe lună, linkuri locale și urmărirea pozițiilor). Prețuri finale, nu se adaugă TVA.',
  },
  {
    q: 'Cât durează până se vede o schimbare?',
    a: 'Depinde de cât de aglomerat e domeniul tău în Brașov. Schimbările pe hartă apar de obicei mai repede decât cele din rezultatele organice, pentru că fișa Google se optimizează direct. Pe organic vorbim de luni, nu de săptămâni. De aceea contractul minim e de 3 luni.',
  },
  {
    q: 'De ce contract minim de 3 luni?',
    a: 'Pentru că prima lună e în mare parte pregătire: fișa Google pusă la punct, datele tale corectate peste tot pe internet, site-ul reparat unde e cazul. Efectul se vede în lunile următoare. Într-o singură lună ai plăti exact partea care încă nu se vede.',
  },
  {
    q: 'Am nevoie de site pentru SEO local?',
    a: 'Pentru hartă, fișa Google contează cel mai mult. Un site legat de fișă, cu pagini pentru fiecare serviciu, ajută însă mult, și e singura cale spre rezultatele organice de sub hartă. Dacă nu ai site, îți spun sincer dacă merită să începi cu el sau doar cu fișa.',
  },
  {
    q: 'Cumpărați recenzii sau linkuri?',
    a: 'Nu. Recenziile false încalcă regulile Google și pot duce la suspendarea fișei. Facem un sistem simplu prin care îi rogi pe clienții mulțumiți să lase o recenzie, și construim linkuri din surse locale reale.',
  },
  {
    q: 'Îmi garantați locul 1?',
    a: 'Nimeni nu poate promite asta corect, pentru că Google ține cont și de cât de aproape ești de cel care caută. Ce îți promit: muncă vizibilă în fiecare lună și un raport din care înțelegi ce s-a schimbat.',
  },
];

const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE}${path}#service`,
    name: 'SEO local și Google Business Profile',
    serviceType: 'SEO local',
    description:
      'Optimizare pentru căutări locale în Brașov: Google Business Profile, citări locale, optimizare on-page, recenzii, articole SEO și raport lunar.',
    provider: { '@id': BUSINESS_ID },
    areaServed: { '@type': 'City', name: 'Brașov' },
    offers: {
      '@type': 'Offer',
      priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: '390', priceCurrency: 'RON', unitText: 'lună' },
    },
    url: `${SITE}${path}`,
  },
  breadcrumb([{ name: 'SEO local Brașov', path }]),
  faqSchema(faq),
];
---
<Base
  ogImage="/assets/og/seo-local-brasov.jpg"
  title="SEO local Brașov | Google Maps și fișa Google · ADSNOW"
  ogTitle="SEO local în Brașov | ADSNOW"
  description="SEO local în Brașov: fișa ta de pe Google pusă la punct, pagini pe servicii, mai multe recenzii și raport lunar. De la 390 lei/lună, setup 600 lei. Top 3 pe hartă pentru un client pornit de la zero."
  path={path}
  schema={schema}
>
  <PageHero
    art="/assets/art/harta.webp"
    crumb="SEO local Brașov"
    title="SEO local în Brașov: apari când te caută cineva din zonă"
    lead="Când cineva scrie pe telefon „dentist Brașov” sau „service auto aproape de mine”, Google arată întâi o hartă cu trei firme. Lucrăm ca tu să fii una dintre ele, și ca site-ul tău să apară imediat sub hartă."
    primary={{ href: '/audit-gratuit', label: 'Vezi unde apari acum →' }}
    secondary={{ href: '#preturi', label: 'Cât costă' }}
    meta={[
      { label: 'Setup Google Maps', value: '600 lei' },
      { label: 'Lunar', value: 'de la 390 lei' },
      { label: 'Contract minim', value: '3 luni' },
      { label: 'Raportare', value: 'lunară' },
    ]}
  />

  <section class="section-dark section-padding">
    <div class="container">
      <span class="eyebrow fade-in" style="color:var(--sky);">Rezultate</span>
      <h2 class="section-title fade-in" style="color:var(--paper);">Ce s-a schimbat pentru doi clienți</h2>
      <CaseStudies only={['armour-glass', 'albastru-infinit']} />
    </div>
  </section>

  <section id="preturi" class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Prețuri</span>
      <h2 class="section-title fade-in">Setup o dată, apoi lunar</h2>
      <p class="section-desc fade-in">Prețuri finale, nu se adaugă TVA. Abonamentele lunare au un minim de 3 luni, pentru că efectul se vede în timp.</p>
      <PriceTable rows={SEO.filter((r) => r.name !== 'Meta Ads')} />
    </div>
  </section>

  <section class="section-muted section-padding">
    <div class="container split">
      <h2 class="section-title fade-in">Cum decide Google pe cine arată pe hartă</h2>
      <div class="prose fade-in">
        <p>Google spune public că ține cont de trei lucruri când alege firmele de pe hartă:</p>
        <ul>
          <li><strong>Relevanța:</strong> cât de bine se potrivește fișa ta cu ce a căutat omul.</li>
          <li><strong>Distanța:</strong> cât de aproape ești de el sau de zona pe care a scris-o.</li>
          <li><strong>Notorietatea:</strong> recenziile, linkurile, cât de cunoscută e afacerea în general.</li>
        </ul>
        <p>Distanța rămâne cum e. Pe celelalte două se poate lucra, și aici e vestea bună: multe firme din Brașov au fișe completate pe jumătate, categorii greșite și recenzii fără răspuns. Locul de pe hartă e la îndemână.</p>
      </div>
    </div>
  </section>

  <section class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Ce facem</span>
      <h2 class="section-title fade-in">Ce fac în fiecare lună</h2>
      <div class="cards-grid">
        <div class="card fade-in">
          <h3>Fișa ta de pe Google, completă</h3>
          <p>Categoriile corecte, serviciile, pozele, programul, postări noi și răspunsuri la recenzii. Asta contează cel mai mult pentru hartă.</p>
        </div>
        <div class="card fade-in">
          <h3>Site-ul spune ce cauți</h3>
          <p>O pagină pentru fiecare serviciu, scrisă cu cuvintele pe care oamenii le tastează pe Google.</p>
        </div>
        <div class="card fade-in">
          <h3>Aceleași date peste tot</h3>
          <p>Numele, adresa și telefonul tău, la fel în toate locurile unde apari online. Google are încredere în ce se potrivește.</p>
        </div>
        <div class="card fade-in">
          <h3>Mai multe recenzii</h3>
          <p>Un link și un cod QR prin care clienții mulțumiți lasă recenzie în 30 de secunde, plus răspuns la fiecare recenzie.</p>
        </div>
        <div class="card fade-in">
          <h3>Articole care răspund clienților</h3>
          <p>Texte despre întrebările pe care ți le pun clienții, ca să te găsească și cei care încă se informează.</p>
        </div>
        <div class="card fade-in">
          <h3>Raport lunar, pe scurt</h3>
          <p>Câți te-au sunat, câți au cerut traseul, unde apari în Google și ce facem luna următoare.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="container">
      <h2 class="section-title fade-in" style="color:var(--paper);">Cum lucrăm</h2>
      <ol class="steps">
        <li class="fade-in"><div><span class="step-when">luna 1</span><h3>Unde ești acum</h3><p>Pe ce căutări apari, cine e înaintea ta și de ce. Alegem căutările care aduc clienți.</p></div></li>
        <li class="fade-in"><div><span class="step-when">luna 1</span><h3>Punem lucrurile în ordine</h3><p>Fișa Google completă și datele tale corectate peste tot pe internet.</p></div></li>
        <li class="fade-in"><div><span class="step-when">luna 2</span><h3>Site-ul</h3><p>Pagini pe servicii, viteză și cum arată pe telefon.</p></div></li>
        <li class="fade-in"><div><span class="step-when">lunar</span><h3>Încredere</h3><p>Recenzii noi și mențiuni pe site-uri locale din Brașov.</p></div></li>
        <li class="fade-in"><div><span class="step-when">lunar</span><h3>Raport</h3><p>Ce s-a schimbat, în cifre pe care le înțelegi, și ce urmează.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Portofoliu</span>
      <h2 class="section-title fade-in">Clienți pe care îi găsești pe Google</h2>
      <ProjectGrid filter="seo" />
      <Related current={path} />
    </div>
  </section>

  <Faq items={faq} title="Întrebări despre SEO local" />
  <CtaFinal />
</Base>
