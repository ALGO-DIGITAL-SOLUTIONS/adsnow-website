---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Effects from '../components/Effects.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import PriceLine from '../components/PriceLine.astro';
import EndCta from '../components/EndCta.astro';
import { PROOF, breadcrumb, faqSchema, SITE, BUSINESS_ID } from '../data/site';

const path = '/seo-local-brasov';
const FAQ = [
  { q: 'Cât durează până se vede o schimbare?', a: 'Pe hartă, schimbările apar de obicei în câteva săptămâni, pentru că fișa Google se îmbunătățește direct. În rezultatele de sub hartă vorbim de luni. De aceea lucrăm minim trei luni.' },
  { q: 'Am nevoie de site?', a: 'Pentru hartă, fișa Google contează cel mai mult. Un site cu o pagină pentru fiecare serviciu ajută însă mult și e singura cale spre rezultatele de sub hartă. Îți spun sincer dacă merită să începi cu el.' },
  { q: 'Cumperi recenzii sau linkuri?', a: 'Nu. Recenziile false încalcă regulile Google și pot duce la suspendarea fișei. Fac un sistem simplu prin care clienții mulțumiți lasă recenzie, iar linkurile vin din surse locale reale.' },
  { q: 'Îmi garantezi locul 1?', a: 'Nimeni nu poate promite asta corect, pentru că Google ține cont și de cât de aproape e omul care caută. Îți promit muncă vizibilă în fiecare lună și un raport din care înțelegi ce s-a schimbat.' },
  { q: 'Ce primesc în raportul lunar?', a: 'Câți te-au sunat din Google, câți au cerut traseul spre tine, pe ce căutări apari și ce fac luna următoare. Pe scurt, în cuvinte pe care le înțelegi.' },
];
const schema = [
  { '@type': 'Service', name: 'SEO local și Google Maps', serviceType: 'Local SEO', provider: { '@id': BUSINESS_ID }, areaServed: 'Brașov', url: `${SITE}${path}` },
  breadcrumb([{ name: 'Google Maps', path }]),
  faqSchema(FAQ),
];
const a = PROOF.armour, b = PROOF.albastru;
---
<Base title="SEO local Brașov: apari pe Google Maps | ADSNOW" description="Când cineva din Brașov caută ce vinzi, apari tu pe hartă. Fișa Google pusă la punct, recenzii reale și un raport lunar cu cine te-a sunat." path={path} schema={schema} ogImage="/assets/og/seo-local-brasov.jpg" preload="/video/harta.webp">
  <ServiceHero crumb="Google Maps" film="harta" title="Când cineva din zonă caută ce vinzi, apari tu pe hartă" lead="Google arată întâi o hartă cu trei firme. Lucrez ca tu să fii una dintre ele, iar site-ul tău să apară imediat sub hartă." />

  <Effects title="Ce se schimbă pentru tine" items={[
    { h: 'Te sună cei din apropiere', p: 'Pe hartă se dau telefoanele: omul caută „service auto” sau „dentist”, vede trei firme și sună. Acolo vrei să fii.' },
    { h: 'Ai recenzii, nu doar o notă', p: 'Un link și un cod QR prin care clienții mulțumiți lasă recenzie în 30 de secunde. Răspund la fiecare recenzie, în numele tău.' },
    { h: 'Știi ce primești', p: 'Lunar vezi câți te-au sunat, câți au cerut traseul spre tine și pe ce căutări apari. Fără grafice pe care nu le înțelege nimeni.' },
  ]} />

  <section class="sec sec-dark on-dark">
    <div class="wrap">
      <div class="sec-head"><h2>Doi clienți, pe Google, azi</h2></div>
      <div class="proof">
        <div class="proof-item proof-half">
          <span class="proof-big">{a.big}</span>
          <p class="proof-line">{a.line}</p>
          <ol class="pack" aria-label="Primele trei rezultate pe hartă">{a.pack.map((m) => <li class:list={{ us: m.us }}><span>{m.name}</span><span class="r">{m.rating} <b aria-hidden="true">★</b> ({m.reviews})</span></li>)}</ol>
          <p class="proof-detail">{a.detail}</p>
          <p class="proof-client"><a href={a.url} target="_blank" rel="noopener">{a.client}</a></p>
        </div>
        <div class="proof-item proof-half">
          <span class="proof-big">{b.big}</span>
          <p class="proof-line">{b.line}</p>
          <p class="proof-detail">{b.detail}</p>
          <p class="proof-client"><a href={b.url} target="_blank" rel="noopener">{b.client}</a></p>
        </div>
      </div>
    </div>
  </section>

  <Steps title="Cum lucrez" lead="Google ține cont de trei lucruri: cât de bine se potrivește fișa cu ce caută omul, cât de aproape e și cât de cunoscută e afacerea. Pe primul și pe ultimul se poate lucra." items={[
    { when: 'Luna 1', h: 'Unde ești acum', p: 'Pe ce căutări apari, cine e înaintea ta și de ce. Alegem căutările care aduc clienți.' },
    { when: 'Luna 1', h: 'Punem ordine', p: 'Fișa Google completă: categorii, servicii, poze, program. Numele, adresa și telefonul la fel peste tot pe internet.' },
    { when: 'Luna 2', h: 'Site-ul spune ce faci', p: 'O pagină pentru fiecare serviciu, scrisă cu cuvintele pe care oamenii le tastează pe Google.' },
    { when: 'În fiecare lună', h: 'Încredere și raport', p: 'Recenzii noi, postări pe fișă, mențiuni pe site-uri locale și un raport scurt cu ce s-a schimbat.' },
  ]} />

  <PriceLine anchor="google-maps" />
  <Faq items={FAQ} title="Întrebări despre Google Maps" />
  <EndCta message="Bună, Alex! Aș vrea să apar mai sus pe Google Maps. Afacerea mea: " />
</Base>
