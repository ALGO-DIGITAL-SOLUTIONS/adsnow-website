---
// Formular scurt pentru cine preferă să scrie decât să vorbească. Trei întrebări, fără buget.
import Base from '../layouts/Base.astro';
import { breadcrumb, WA_DEFAULT } from '../data/site';
const path = '/audit-gratuit';
---
<Base title="Spune-mi ce faci și îți răspund cu o propunere | ADSNOW" description="Trei întrebări, două minute. A doua zi îți scriu ce aș face în locul tău ca să ai mai mulți clienți, cu prețul fiecărui pas." path={path} schema={[breadcrumb([{ name: 'Formular', path }])]} ogImage="/assets/og/audit-gratuit.jpg" dark={false}>
  <section class="sec" style="padding-top:clamp(140px,16vw,200px)">
    <div class="wrap narrow">
      <div class="sec-head">
        <h1 style="font-size:clamp(44px,5.6vw,84px)">Spune-mi ce faci. Îți scriu ce aș face eu.</h1>
        <p class="lead muted">Trei întrebări, două minute. A doua zi îți trimit pe email sau pe WhatsApp ce aș schimba ca să ai mai mulți clienți, cu prețul fiecărui pas. Fără obligații. Preferi să vorbim direct? <a href={WA_DEFAULT} class="textlink" target="_blank" rel="noopener" data-track="whatsapp">Scrie-mi pe WhatsApp</a>.</p>
      </div>

      <form class="form" id="form" novalidate>
        <fieldset>
          <legend>Ce ai acum online?</legend>
          <div class="opts">
            <label><input type="radio" name="online" value="Am site, dar nu-mi aduce clienți" required/>Am site, dar nu-mi aduce clienți</label>
            <label><input type="radio" name="online" value="Am doar Facebook sau Instagram"/>Am doar Facebook sau Instagram</label>
            <label><input type="radio" name="online" value="Nu am nimic, pornesc acum"/>Nu am nimic, pornesc acum</label>
            <label><input type="radio" name="online" value="Am de toate, vreau o părere"/>Am de toate, vreau o părere</label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Ce vrei să se schimbe?</legend>
          <div class="opts">
            <label><input type="radio" name="vreau" value="Să mă găsească cei din zonă pe Google" required/>Să mă găsească cei din zonă pe Google</label>
            <label><input type="radio" name="vreau" value="Să arăt mai serios online"/>Să arăt mai serios online</label>
            <label><input type="radio" name="vreau" value="Să mă vadă lumea pe Instagram și TikTok"/>Să mă vadă lumea pe Instagram și TikTok</label>
            <label><input type="radio" name="vreau" value="Să nu mai pierd cereri și programări"/>Să nu mai pierd cereri și programări</label>
          </div>
        </fieldset>
        <label class="field"><span class="q display" style="font-size:26px">Cu ce te ocupi?</span><small>O propoziție e de ajuns: ce faci și pentru cine.</small><textarea name="afacere" rows="3" required></textarea></label>
        <div class="field"><span class="display" style="font-size:26px">Unde îți răspund?</span></div>
        <label class="field"><span>Nume</span><input type="text" name="nume" autocomplete="name" required/></label>
        <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required/></label>
        <label class="field"><span>WhatsApp</span><small>Opțional. Așa îți răspund mai repede.</small><input type="tel" name="telefon" autocomplete="tel"/></label>
        <label class="field"><span>Site-ul tău</span><small>Opțional.</small><input type="text" name="site" inputmode="url"/></label>
        <input class="hp" type="text" name="website_url_hp" tabindex="-1" autocomplete="off" aria-hidden="true"/>
        <p class="form-error" id="form-error" role="alert" hidden></p>
        <div><button type="submit" class="btn btn-coral" id="form-send">Trimite</button></div>
        <p class="muted" style="font-size:15px">Folosesc datele doar ca să îți răspund. Detalii în <a href="/politica-confidentialitate" class="textlink">politica de confidențialitate</a>.</p>
      </form>

      <div class="form-done" id="form-done" hidden tabindex="-1">
        <h2 style="font-size:40px">Am primit. Mulțumesc!</h2>
        <p style="margin-top:12px" class="muted">Îți răspund în cel mult o zi lucrătoare. Dacă scrii pe email, uită-te și în folderul de spam.</p>
      </div>
    </div>
  </section>
</Base>

<script is:inline slot="scripts">
(function () {
  var form = document.getElementById('form'), err = document.getElementById('form-error'), btn = document.getElementById('form-send');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (form.website_url_hp.value) return;
    if (!form.checkValidity()) {
      err.textContent = 'Completează întrebările, numele și un email valid, apoi trimite din nou.';
      err.hidden = false; var bad = form.querySelector(':invalid'); if (bad) bad.focus(); return;
    }
    err.hidden = true; btn.disabled = true; btn.textContent = 'Se trimite';
    fetch('https://formspree.io/f/xaqvrkwe', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
      .then(function (r) {
        if (!r.ok) throw new Error();
        form.hidden = true; var d = document.getElementById('form-done'); d.hidden = false; d.focus();
        if (window.adsnowLead) window.adsnowLead();
      })
      .catch(function () {
        btn.disabled = false; btn.textContent = 'Trimite';
        err.textContent = 'Mesajul nu a plecat. Încearcă din nou sau scrie-mi la alex@adsnow.ro.'; err.hidden = false;
      });
  });
})();
</script>
