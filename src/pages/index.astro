---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import CaseStudies from '../components/CaseStudies.astro';
import HeroParticles from '../components/HeroParticles.astro';
import { SITE, BUSINESS_ID, CONTACT, SERVICES, faqSchema } from '../data/site';
import { PACKAGES } from '../data/pricing';
import { REVIEWS, REVIEWS_SUMMARY } from '../data/reviews';

const faq = [
  {
    q: 'Chiar e gata site-ul în 10 zile?',
    a: 'Da, în 10 zile lucrătoare de la ce primesc materialele: logo, poze, informațiile de bază. În prima zi îți trimit lista exactă. Din ziua 3 vezi site-ul pe un link de test, iar fiecare rundă de feedback durează 48 de ore. Ritmul îl dai tu: cu cât răspunzi mai repede, cu atât lansăm mai repede.',
  },
  {
    q: 'De ce sunt prețurile pe site?',
    a: 'Ca să știi de la început cât costă, fără să ceri ofertă și să aștepți. Lista e aceeași pentru toată lumea: o cafenea și o clinică plătesc același preț pentru același lucru. Diferă doar volumul pe care îl alegi. Prețurile sunt finale, nu se mai adaugă TVA.',
  },
  {
    q: 'Cu ce diferiți de o agenție obișnuită?',
    a: 'Vorbești direct cu omul care îți face site-ul, filmează reels-urile și îți optimizează fișa Google. Nu există account manager care să transmită mai departe ce ai vrut să spui. De aceea mergem repede: deciziile se iau într-un mesaj, nu într-o ședință.',
  },
  {
    q: 'Faceți și filmări?',
    a: 'Da. Filmez la tine, în Brașov și în zona de până la o oră de mers: reels, video de prezentare de 1-2 minute, fotografii. Materialul îl folosești apoi pe site, pe social media și în reclame.',
  },
  {
    q: 'Lucrați doar cu firme din Brașov?',
    a: 'Site-urile, SEO-ul și automatizările le fac pentru clienți din toată țara. Filmările le fac în Brașov și în zona de până la o oră.',
  },
  {
    q: 'Ce se întâmplă dacă vreau să renunț la abonament?',
    a: 'Abonamentele au un minim de 3 luni, pentru că SEO-ul și conținutul au nevoie de timp ca să dea rezultate. După aceea te poți opri oricând, cu o lună înainte. Tot ce am făcut pentru tine îți rămâne: site, poze, video, conturi.',
  },
];

const schema = [
  {
    '@type': ['LocalBusiness', 'MarketingAgency'],
    '@id': BUSINESS_ID,
    name: 'ADSNOW',
    legalName: 'ALGO Digital Solutions SRL',
    description:
      'Marketing rapid pentru afaceri locale din Brașov: site-uri în 10 zile, SEO local și Google Maps, reels și video de prezentare, automatizări.',
    url: SITE,
    telephone: CONTACT.phoneIntl,
    email: CONTACT.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: CONTACT.street,
      addressLocality: CONTACT.city,
      addressRegion: 'BV',
      postalCode: CONTACT.postalCode,
      addressCountry: 'RO',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 45.6427, longitude: 25.5887 },
    founder: { '@type': 'Person', name: 'Alexandru Gogu', jobTitle: 'Fondator' },
    foundingDate: '2023',
    areaServed: [
      { '@type': 'City', name: 'Brașov' },
      { '@type': 'Country', name: 'România' },
    ],
    priceRange: '90-4400 RON',
    image: `${SITE}/assets/logo.webp`,
    logo: `${SITE}/assets/logo.webp`,
    sameAs: [
      'https://www.facebook.com/adsnow.ro',
      'https://www.instagram.com/adsnow.ro/',
      'https://www.tiktok.com/@adsnow.ro',
      CONTACT.gbp,
    ],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicii de marketing pentru afaceri locale',
      itemListElement: SERVICES.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', '@id': `${SITE}${s.href}#service`, name: s.title, url: `${SITE}${s.href}` },
      })),
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    url: SITE,
    name: 'ADSNOW',
    publisher: { '@id': BUSINESS_ID },
    inLanguage: 'ro-RO',
  },
  {
    '@type': 'WebPage',
    '@id': `${SITE}/#webpage`,
    url: `${SITE}/`,
    name: 'Agenție de marketing Brașov: site în 10 zile, SEO local, reels | ADSNOW',
    isPartOf: { '@id': `${SITE}/#website` },
    about: { '@id': BUSINESS_ID },
    inLanguage: 'ro-RO',
  },
  faqSchema(faq),
];
---
<Base
  title="Agenție de marketing Brașov | Site în 10 zile, SEO local, reels · ADSNOW"
  ogTitle="Site nou în 10 zile. Clienți din Google Maps în fiecare lună. | ADSNOW"
  description="Marketing pentru afaceri locale din Brașov: site gata în 10 zile, SEO local și Google Maps, reels și video de prezentare, automatizări. Toate prețurile sunt pe site."
  path="/"
  schema={schema}
  preloadHero
>
  <section id="hero">
    <div class="hero-content">
      <div class="hero-eyebrow">Agenție de marketing pentru afaceri locale · Brașov</div>
      <h1 class="hero-title">Site nou în 10 zile. Clienți din Google Maps în fiecare lună.</h1>
      <p class="hero-sub">Site-uri, SEO local, reels și automatizări pentru afaceri locale din Brașov și din toată țara. Vorbești direct cu cel care le face, iar toate prețurile sunt pe site.</p>
      <div class="hero-actions">
        <a href="/preturi" class="btn-primary">Vezi pachetele și prețurile →</a>
        <a href="/audit-gratuit" class="btn-secondary">Audit gratuit în 2 minute</a>
      </div>
      <p class="hero-proof"><span class="stars" aria-hidden="true">★★★★★</span>{REVIEWS_SUMMARY.rating} din {REVIEWS_SUMMARY.count} recenzii pe Google</p>
    </div>
    <div class="hero-visual">
      <div class="hero-orb"></div>
      <canvas id="heroCanvas"></canvas>
      <p class="hero-logo-text">ADSNOW</p>
    </div>
  </section>

  <section id="rezultate" class="section-dark section-padding">
    <div class="container">
      <span class="eyebrow fade-in" style="color:var(--sky);">Rezultate, nu promisiuni</span>
      <h2 class="section-title fade-in" style="color:var(--paper);">Ce au primit clienții în ultimele luni</h2>
      <CaseStudies />
      <div class="fade-in" style="margin-top:40px;">
        <a href="/proiecte" class="btn-secondary" style="color:var(--paper);border-color:rgba(244,241,236,0.3);">Vezi studiile de caz →</a>
      </div>
    </div>
  </section>

  <section id="pachete" class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Pachete cu preț fix</span>
      <h2 class="section-title fade-in">Alegi pachetul, știi prețul de la început</h2>
      <p class="section-desc fade-in">Aceeași listă de prețuri pentru toți. Pachetele diferă prin volum, nu prin cine ești. Prețurile sunt finale, nu se adaugă TVA.</p>
      <div class="cards-grid">
        {PACKAGES.map((p) => (
          <div class:list={['card', 'package-card', 'fade-in', { featured: p.featured }]}>
            <span class="card-kicker">{p.kicker}</span>
            <h3>{p.name}</h3>
            <p>{p.what}</p>
            <ul>{p.includes.map((i) => <li>{i}</li>)}</ul>
            <div class="card-price">{p.price}{p.note && <small>{p.note}</small>}</div>
            <div class="package-separate">{p.separate}</div>
          </div>
        ))}
      </div>
      <div class="fade-in" style="margin-top:40px;">
        <a href="/preturi" class="btn-primary">Toate prețurile →</a>
      </div>
    </div>
  </section>

  <section id="servicii" class="section-dark section-padding">
    <div class="container">
      <h2 class="section-title fade-in" style="color:var(--paper);">Servicii de marketing în Brașov</h2>
      <p class="section-desc fade-in">Le poți lua separat sau în pachet. Fiecare serviciu are pagina lui, cu ce primești, în cât timp și cât costă.</p>
      <div class="services-grid four">
        {SERVICES.map((s) => (
          <a href={s.href} class="service-card fade-in">
            {s.tag && <span class="service-tag">{s.tag}</span>}
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <div class="service-meta">
              <div class="service-meta-line">Preț: <strong>{s.price}</strong> ({s.priceNote})</div>
              <div class="service-meta-line">Durată: <strong>{s.time}</strong></div>
            </div>
            <span class="service-more">Vezi detalii →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="zece-zile" class="section-dark section-padding" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow fade-in" style="color:var(--sky);">Cum lansăm un site</span>
      <h2 class="section-title fade-in" style="color:var(--paper);">10 zile lucrătoare, de la materiale la site live</h2>
      <div class="ten-days fade-in">
        <div><span class="day">Ziua 1</span><h3>Lista de materiale</h3><p>Primești lista exactă: logo, poze, prețuri, ce vrei să spună site-ul. Texte nu trebuie să scrii, le scriu eu.</p></div>
        <div><span class="day">Ziua 3</span><h3>Site-ul pe un link de test</h3><p>Vezi site-ul cum se construiește, pe telefon și pe calculator. Nu aștepți o lună ca să vezi ceva.</p></div>
        <div><span class="day">Zilele 4–8</span><h3>Feedback în 48 de ore</h3><p>Îmi spui ce schimbăm, eu modific în cel mult două zile. Deciziile se iau într-un mesaj.</p></div>
        <div><span class="day">Ziua 10</span><h3>Lansare</h3><p>Site live, legat de fișa Google și de Google Analytics. Primești parolele și o oră de training.</p></div>
      </div>
      <p class="ten-days-note fade-in"><strong>Termenul curge de la primirea materialelor complete. Ritmul îl dai tu:</strong> cu cât răspunzi mai repede, cu atât lansăm mai repede.</p>
    </div>
  </section>

  <section id="cum-lucrez" class="section-light section-padding">
    <div class="container">
      <h2 class="section-title fade-in">Cum lucrez</h2>
      <p class="section-desc fade-in">Trei principii.</p>
      <div class="principles-grid">
        <div class="principle-card fade-in">
          <h3>Vorbești direct cu cel care face</h3>
          <p>Eu îți fac site-ul, eu filmez, eu optimizez fișa Google. Nu există un account manager între noi. De aceea mergem repede și nimic nu se pierde pe drum.</p>
        </div>
        <div class="principle-card fade-in">
          <h3>Spun nu mai des decât spun da</h3>
          <p>Primești doar serviciile care îți rezolvă o problemă. Dacă nu ai nevoie de social media lunar, îți spun să economisești banii. Dacă site-ul tău actual e în regulă, îți spun asta din primul mesaj, chiar dacă pierd vânzarea.</p>
        </div>
        <div class="principle-card fade-in">
          <h3>Primești și veștile proaste</h3>
          <p>Dacă ceva nu funcționează, afli de la mine, nu din factură. În fiecare lună primești un raport scurt cu apeluri, cereri și poziții în Google, nu cu like-uri.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="pentru-cine" class="section-muted section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Pentru cine</span>
      <h2 class="section-title fade-in">Afaceri locale care vor clienți din zonă</h2>
      <div class="sector-grid">
        {[
          { k: 'Sănătate', t: 'Clinici, cabinete medicale, stomatologie, psihologie' },
          { k: 'Auto și construcții', t: 'Service-uri, ateliere, constructori, instalatori' },
          { k: 'Ospitalitate și beauty', t: 'Cafenele, restaurante, saloane, săli de sport' },
          { k: 'Profesii liberale', t: 'Avocatură, notariat, contabilitate' },
          { k: 'Imobiliare și B2B', t: 'Dezvoltatori, agenții de recrutare, firme B2B mici' },
          { k: 'Afaceri noi', t: 'Online repede, cu site, fișă Google și conținut din prima lună' },
        ].map((s) => (
          <div class="sector fade-in"><span class="sector-k">{s.k}</span><p>{s.t}</p></div>
        ))}
      </div>
      <div class="fit-strip fade-in">
        <h3>Colaborarea merge cel mai bine când</h3>
        <ol>
          <li><strong>Răspunzi în 1–2 zile.</strong> Materialele și feedbackul rapid țin site-ul în cele 10 zile.</li>
          <li><strong>Gândești pe termen lung.</strong> SEO local aduce rezultate clare în 3–6 luni și crește de acolo.</li>
          <li><strong>Vrei creștere reală.</strong> Clienți, urmăritori și recenzii venite organic, din oameni reali.</li>
        </ol>
      </div>
    </div>
  </section>

  <section id="recenzii" class="section-light section-padding">
    <div class="container">
      <div class="reviews-head">
        <div>
          <span class="eyebrow fade-in">Recenzii Google</span>
          <h2 class="section-title fade-in">Ce spun clienții</h2>
        </div>
        <div class="fade-in">
          <div class="reviews-score">{REVIEWS_SUMMARY.rating}<small>din {REVIEWS_SUMMARY.count} recenzii pe Google</small></div>
          <div class="reviews-stars" aria-hidden="true">★★★★★</div>
        </div>
      </div>
      <div class="cards-grid">
        {REVIEWS.map((r) => (
          <figure class="card review-card fade-in">
            <blockquote>„{r.text}”</blockquote>
            <cite>{r.name} · {r.business}</cite>
          </figure>
        ))}
      </div>
      <div class="fade-in" style="margin-top:32px;">
        <a href={CONTACT.gbp} target="_blank" rel="noopener" class="btn-secondary">Vezi toate recenziile pe Google →</a>
      </div>
    </div>
  </section>

  <section id="portofoliu" class="section-muted section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Portofoliu</span>
      <h2 class="section-title fade-in">Proiecte recente din Brașov</h2>
      <p class="section-desc fade-in">Site-uri live, la care am lucrat de la primul mesaj până la lansare.</p>
      <ProjectGrid limit={3} />
      <div style="text-align:center;margin-top:40px;">
        <a href="/proiecte" class="btn-secondary portfolio-expand fade-in">Toate proiectele →</a>
      </div>
    </div>
  </section>

  <section id="despre" class="section-light section-padding">
    <div class="container">
      <h2 class="section-title fade-in">Cine sunt</h2>
      <div class="about-grid">
        <div class="about-photo fade-in">
          <img src="/assets/alex-gogu.webp" alt="Alexandru Gogu, fondator ADSNOW" width="400" height="600" loading="lazy"/>
        </div>
        <div>
          <p class="about-text fade-in">Sunt Alex Gogu, fondatorul <strong>ADSNOW</strong>. Fac site-uri, SEO local, reels și automatizări pentru afaceri locale. Eu sunt omul cu care vorbești de la primul mesaj până la lansare, și tot eu sunt cel care face efectiv treaba.</p>
          <p class="about-text fade-in">Lucrez cu unelte moderne și cu AI, de aceea un site care la alte agenții durează o lună la mine e gata în 10 zile. Viteza nu vine din grabă, ci din faptul că nu se pierde timp între oameni.</p>
          <p class="about-text fade-in">Înainte de ADSNOW am pus fundațiile unei agenții la Montreal, ca Project Manager, și am co-fondat o firmă de marketing în Spania, ca CTO. Acolo am văzut cum arată o agenție care îți adaugă servicii doar ca să-și acopere costurile. <strong>Nu vreau să lucrez așa.</strong></p>
          <p class="about-text fade-in">Mă găsești și pe <a href="https://www.instagram.com/adsnow.ro/" target="_blank" rel="noopener" style="color:var(--cobalt);text-decoration:underline;">Instagram</a>, unde arăt cum lucrez, cu exemple de înainte și după.</p>
          <a href="/audit-gratuit" class="btn-primary fade-in" style="margin-top:24px;">Începe cu auditul gratuit →</a>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} desc="Răspunsuri scurte la lucrurile pe care le aud cel mai des. Dacă nu găsești răspunsul, scrie-mi direct." tone="muted" />
  <CtaFinal />

  <HeroParticles slot="scripts" />
</Base>
