---
import Base from '../layouts/Base.astro';
import Film from '../components/Film.astro';
import Reels from '../components/Reels.astro';
import Faq from '../components/Faq.astro';
import EndCta from '../components/EndCta.astro';
import { SERVICES, PROOF, ALEX_VIDEO, CONTACT, WA_DEFAULT, faqSchema, SITE } from '../data/site';
import { REVIEWS, REVIEWS_SUMMARY } from '../data/reviews';

const FAQ = [
  { q: 'Chiar e gata site-ul în 10 zile?', a: 'Da, în 10 zile lucrătoare de când am logo-ul, câteva poze și informațiile de bază. Din ziua a treia îl vezi pe telefon, pe un link de test, iar la fiecare modificare îți răspund în cel mult două zile.' },
  { q: 'Trebuie să mă pricep la ceva tehnic?', a: 'Deloc. Tu îmi spui ce faci și pentru cine, eu mă ocup de texte, design, Google și filmare. La final îți arăt într-o oră ce trebuie să știi și primești toate parolele.' },
  { q: 'Cu cine vorbesc?', a: 'Cu mine, Alex. De la primul mesaj până după lansare, tot eu răspund și tot eu fac treaba. Nu există intermediari.' },
  { q: 'Vii să filmezi la mine?', a: 'Da, în Brașov și până la o oră de mers. Filmez reels, video de prezentare și poze, pe care le folosești apoi pe site, pe Instagram, pe TikTok și în reclame.' },
  { q: 'Lucrezi doar cu firme din Brașov?', a: 'Site-urile, Google Maps și automatizările le fac pentru afaceri din toată țara. Filmările le fac în Brașov și în zona de până la o oră.' },
];
---
<Base
  title="ADSNOW Brașov: site, Google Maps și video pentru afaceri locale"
  description="Mai mulți clienți din zonă: site gata în 10 zile, loc pe Google Maps și video filmate la tine. Lucrezi direct cu Alex, la prețuri fixe și publice."
  path="/"
  preload="/video/acasa.webp"
  preloadMobile="/video/acasa-v.webp"
  schema={[faqSchema(FAQ), { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'ADSNOW', inLanguage: 'ro-RO' }]}
>
  <section class="hero">
    <Film name="acasa" eager vertical />
    <div class="wrap hero-in">
      <h1><span class="ln"><span>Mai mulți clienți</span></span><span class="ln"><span>pentru afacerea ta,</span></span><span class="ln"><span>fără să te ocupi de marketing.</span></span></h1>
      <p class="lead">Site gata în 10 zile, loc pe Google Maps când te caută cei din zonă și video filmate la tine. Le fac eu, de la cap la coadă, la prețuri pe care le știi de acum.</p>
      <div class="btn-row">
        <a href={WA_DEFAULT} class="btn btn-coral" target="_blank" rel="noopener" data-track="whatsapp">Scrie-mi pe WhatsApp</a>
        <a href="#ce-se-schimba" class="btn btn-ghost-light">Vezi ce se schimbă pentru tine</a>
      </div>
      <p class="hero-proof"><span class="stars" aria-hidden="true">★★★★★</span><a href={CONTACT.gbp} target="_blank" rel="noopener">{REVIEWS_SUMMARY.rating} din {REVIEWS_SUMMARY.count} recenzii pe Google</a></p>
    </div>
  </section>

  <section class="sec" id="ce-se-schimba">
    <div class="wrap">
      <div class="sec-head">
        <h2>Ce se schimbă pentru afacerea ta</h2>
        <p class="lead muted">Patru lucruri care aduc clienți. Le iei pe rând, sau pe toate odată.</p>
      </div>
      {SERVICES.map((s) => (
        <article class="chapter">
          <div class="chapter-media">
            <Film name={s.caz?.film ?? s.film} class="chapter-film" />
          </div>
          <div>
            <h3 class="chapter-title">{s.title}</h3>
            <p class="lead">{s.lead}</p>
            <ul class="effects">{s.effects.map((e) => <li>{e}</li>)}</ul>
            {s.caz && <p class="chapter-note">{s.caz.note}</p>}
            <a href={s.href} class="textlink">Cum lucrez la {s.nav.toLowerCase()}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec-dark on-dark" id="rezultate">
    <div class="wrap">
      <div class="sec-head">
        <h2>Ce s-a schimbat pentru clienții mei</h2>
        <p class="lead muted">Cifre verificate în noiembrie 2026, direct din Google și din conturile lor. Proiectele sunt live, le poți deschide.</p>
      </div>
      <div class="proof">
        <div class="proof-item">
          <span class="proof-big">{PROOF.armour.big}</span>
          <p class="proof-line">{PROOF.armour.line}</p>
          <ol class="pack" aria-label="Primele trei rezultate pe hartă">
            {PROOF.armour.pack.map((m) => <li class:list={{ us: m.us }}><span>{m.name}</span><span class="r">{m.rating} <b aria-hidden="true">★</b> ({m.reviews})</span></li>)}
          </ol>
          <p class="proof-detail">{PROOF.armour.detail}</p>
          <p class="proof-client"><a href={PROOF.armour.url} target="_blank" rel="noopener">{PROOF.armour.client}</a></p>
        </div>
        <div class="proof-item">
          <span class="proof-big">{PROOF.albastru.big}</span>
          <p class="proof-line">{PROOF.albastru.line}</p>
          <p class="proof-detail">{PROOF.albastru.detail}</p>
          <p class="proof-client"><a href={PROOF.albastru.url} target="_blank" rel="noopener">{PROOF.albastru.client}</a></p>
        </div>
        <div class="proof-item">
          <span class="proof-big" style="font-size:clamp(44px,4.4vw,72px)">{PROOF.ozone.big}</span>
          <p class="proof-line">{PROOF.ozone.line}</p>
          <p class="proof-detail">{PROOF.ozone.detail}</p>
          <p class="proof-client"><a href={PROOF.ozone.url} target="_blank" rel="noopener">{PROOF.ozone.client}</a></p>
        </div>
      </div>
      <p style="margin-top:56px"><a href="/proiecte" class="textlink">Toate proiectele</a></p>
    </div>
  </section>

  <section class="sec-tight sec-night on-dark" aria-labelledby="reels-h">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:40px">
        <h2 id="reels-h">Filmate la clienți, montate de mine</h2>
        <p class="lead muted">Atinge un video ca să pornești sunetul.</p>
      </div>
      <Reels />
    </div>
  </section>

  <section class="sec" id="despre">
    <div class="wrap alex">
      <div class="alex-media">
        {ALEX_VIDEO
          ? <video src={ALEX_VIDEO} poster="/assets/alex-gogu.webp" controls playsinline preload="none"></video>
          : <img src="/assets/alex-gogu.webp" alt="Alex Gogu, fondatorul ADSNOW" width="400" height="600" loading="lazy"/>}
      </div>
      <div>
        <blockquote>„Salut, sunt Alex. Îți scriu textele, îți fac site-ul, vin la tine să filmez și mă uit lunar câți clienți ți-au venit din Google.”</blockquote>
        <p class="lead">Am lucrat ani la rând în proiecte mari de marketing. Acum lucrez cu afaceri locale, una câte una, și vorbești direct cu mine de la primul mesaj până după lansare.</p>
        <div class="btn-row">
          <a href={WA_DEFAULT} class="btn btn-indigo" target="_blank" rel="noopener" data-track="whatsapp">Scrie-mi pe WhatsApp</a>
          <a href={`tel:${CONTACT.phoneIntl}`} class="btn btn-ghost-dark" data-track="telefon">Sună la {CONTACT.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-dark on-dark" id="zece-zile">
    <div class="wrap">
      <div class="sec-head">
        <h2>Tu îmi trimiți logo-ul și câteva poze. Restul e treaba mea.</h2>
      </div>
      <ol class="days">
        <li><span class="when">Ziua 1</span><h3>Vorbim 20 de minute</h3><p>Îmi spui ce faci și pentru cine. Primești lista scurtă cu ce îmi trebuie.</p></li>
        <li><span class="when">Ziua 3</span><h3>Îl vezi pe telefon</h3><p>Primești un link și vezi site-ul cum prinde formă.</p></li>
        <li><span class="when">Zilele 4–8</span><h3>Îl ajustăm împreună</h3><p>Îmi scrii pe WhatsApp ce schimbăm. Modific în cel mult două zile.</p></li>
        <li><span class="when">Ziua 10</span><h3>E live</h3><p>Pe domeniul tău, legat de Google Maps. Primești parolele și îți arăt cum se folosește.</p></li>
      </ol>
      <p class="days-note"><strong>Ritmul îl dai tu.</strong> Cele 10 zile încep când am materialele. Cu cât răspunzi mai repede, cu atât lansăm mai repede.</p>
    </div>
  </section>

  <section class="sec sec-mist" id="recenzii">
    <div class="wrap">
      <div class="rating">
        <span class="display">{REVIEWS_SUMMARY.rating}</span>
        <div><span class="stars" aria-hidden="true">★★★★★</span><p class="muted">din {REVIEWS_SUMMARY.count} recenzii pe <a href={CONTACT.gbp} target="_blank" rel="noopener" class="textlink">Google</a></p></div>
      </div>
      <div class="quotes">
        {REVIEWS.map((r) => (
          <figure>
            <blockquote>„{r.text}”</blockquote>
            <figcaption><strong>{r.name}</strong>, {r.business}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Faq items={FAQ} />
  <EndCta />
</Base>
