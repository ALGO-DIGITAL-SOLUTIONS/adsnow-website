---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import PriceTable from '../components/PriceTable.astro';
import Related from '../components/Related.astro';
import { SITE, BUSINESS_ID, breadcrumb, faqSchema } from '../data/site';
import { AUTOMATIONS } from '../data/pricing';

const path = '/automatizari';

const faq = [
  {
    q: 'Am nevoie de cunoștințe tehnice?',
    a: 'Nu. Eu construiesc totul și îți arăt într-un apel scurt unde vezi cererile și programările. Tu doar primești mesajele pe telefon.',
  },
  {
    q: 'Ce costuri lunare apar în plus?',
    a: 'La majoritatea, niciunul. Folosim ce ai deja, Google Calendar și WhatsApp Business, sau variante gratuite. La asistentul AI e un abonament de 150 lei pe lună, care acoperă costul lui și întreținerea.',
  },
  {
    q: 'Asistentul AI poate spune ceva greșit clienților?',
    a: 'Răspunde doar din informațiile pe care i le dăm noi: servicii, prețuri, program, adresă. La orice întrebare la care nu știe răspunsul, preia datele clientului și îți trimite cererea ție.',
  },
  {
    q: 'Funcționează cu site-ul pe care îl am deja?',
    a: 'De cele mai multe ori, da. Formularele, programările și asistentul AI se pot adăuga pe aproape orice site. Dacă al tău nu permite, îți spun din primul mesaj.',
  },
];

const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE}${path}#service`,
    name: 'Automatizări pentru afaceri mici',
    serviceType: 'Automatizare marketing',
    description:
      'Kit de recenzii Google, formulare care trimit cererile pe WhatsApp, programări online cu reminder, răspuns automat la lead-uri și asistent AI pentru site și WhatsApp.',
    provider: { '@id': BUSINESS_ID },
    areaServed: { '@type': 'Country', name: 'România' },
    offers: {
      '@type': 'Offer',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: '450', maxPrice: '1690', priceCurrency: 'RON' },
    },
    url: `${SITE}${path}`,
  },
  breadcrumb([{ name: 'Automatizări', path }]),
  faqSchema(faq),
];
---
<Base
  title="Automatizări pentru afaceri mici: WhatsApp, programări, recenzii · ADSNOW"
  ogTitle="Automatizări pentru afaceri mici | ADSNOW"
  description="Cereri care ajung direct pe WhatsApp, programări online cu reminder, recenzii Google cerute automat, asistent AI pe site. De la 450 lei, gata în 2-14 zile."
  path={path}
  schema={schema}
>
  <PageHero
    crumb="Automatizări"
    title="Nu mai pierde niciun client care ți-a scris"
    lead="Cererile de pe site ajung direct pe WhatsApp, clienții își fac singuri programarea, iar cei mulțumiți primesc automat linkul de recenzie. Lucruri simple, care îți economisesc ore în fiecare săptămână."
    primary={{ href: '#preturi', label: 'Vezi prețurile →' }}
    secondary={{ href: '/audit-gratuit', label: 'Audit gratuit' }}
    meta={[
      { label: 'Preț', value: 'de la 450 lei' },
      { label: 'Gata în', value: '2–14 zile' },
      { label: 'Pachet Pilot automat', value: '1.690 lei' },
    ]}
  />

  <section class="section-muted section-padding">
    <div class="container split">
      <h2 class="section-title fade-in">Unde scapă clienții</h2>
      <div class="prose fade-in">
        <p>Majoritatea afacerilor mici nu pierd clienți din lipsă de vizibilitate, ci după ce clientul a scris deja: emailul citit a doua zi, telefonul nepreluat în timpul unei programări, mesajul de pe Instagram uitat.</p>
        <ul>
          <li>Cererea din formular ajunge într-un email pe care nu-l verifici des</li>
          <li>Programările se fac doar la telefon, iar telefonul sună când lucrezi</li>
          <li>Clienții mulțumiți nu lasă recenzie, pentru că nimeni nu le-a cerut</li>
          <li>Răspunzi la aceleași întrebări despre prețuri și program de zece ori pe zi</li>
        </ul>
        <p><strong>Fiecare dintre ele se rezolvă cu o automatizare simplă</strong>, construită o dată, care merge singură.</p>
      </div>
    </div>
  </section>

  <section id="preturi" class="section-light section-padding">
    <div class="container">
      <span class="eyebrow fade-in">Prețuri</span>
      <h2 class="section-title fade-in">Ce poți automatiza</h2>
      <p class="section-desc fade-in">Prețuri finale, nu se adaugă TVA. Plata: 50% la început, 50% la livrare. Primele trei, împreună, formează pachetul <strong>Pilot automat</strong>, la 1.690 lei în loc de 2.050.</p>
      <PriceTable rows={AUTOMATIONS} />
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="container">
      <h2 class="section-title fade-in" style="color:var(--paper);">Cum lucrăm</h2>
      <ol class="steps">
        <li class="fade-in"><div><span class="step-when">ziua 1</span><h3>Discuție de 20 de minute</h3><p>Îmi spui cum vin acum cererile și programările și unde se pierd. Alegem una sau două automatizări, nu zece.</p></div></li>
        <li class="fade-in"><div><span class="step-when">zilele 2-7</span><h3>Construcție și testare</h3><p>Construiesc fluxul și îl testez cu cereri de probă, pe telefonul tău.</p></div></li>
        <li class="fade-in"><div><span class="step-when">livrare</span><h3>Predare</h3><p>Îți arăt unde vezi totul și ce faci dacă vrei să schimbi un mesaj. Primele 30 de zile, orice ajustare e inclusă.</p></div></li>
      </ol>
      <Related current={path} />
    </div>
  </section>

  <Faq items={faq} title="Întrebări despre automatizări" />
  <CtaFinal />
</Base>
