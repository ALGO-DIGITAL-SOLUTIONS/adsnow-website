---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Effects from '../components/Effects.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import PriceLine from '../components/PriceLine.astro';
import EndCta from '../components/EndCta.astro';
import { breadcrumb, faqSchema, SITE, BUSINESS_ID } from '../data/site';

const path = '/automatizari';
const FAQ = [
  { q: 'Am nevoie de cunoștințe tehnice?', a: 'Nu. Construiesc totul și îți arăt într-un apel scurt unde vezi cererile și programările. Tu doar primești mesajele pe telefon.' },
  { q: 'Apar costuri lunare în plus?', a: 'La majoritatea, niciunul: folosim ce ai deja, Google Calendar și WhatsApp Business. Doar asistentul pentru întrebări are un abonament mic, care acoperă costul lui.' },
  { q: 'Funcționează cu site-ul pe care îl am?', a: 'De cele mai multe ori, da. Formularele și programările se pot adăuga pe aproape orice site. Dacă al tău nu permite, îți spun din primul mesaj.' },
  { q: 'Asistentul poate spune ceva greșit clienților?', a: 'Răspunde doar din informațiile pe care i le dăm: servicii, program, adresă. La orice întrebare la care nu știe răspunsul, preia datele omului și îți trimite cererea ție.' },
];
const schema = [
  { '@type': 'Service', name: 'Automatizări pentru afaceri mici', serviceType: 'Business automation', provider: { '@id': BUSINESS_ID }, areaServed: 'Brașov', url: `${SITE}${path}` },
  breadcrumb([{ name: 'Automatizări', path }]),
  faqSchema(FAQ),
];
---
<Base title="Automatizări: cereri pe WhatsApp și programări | ADSNOW" description="Cererile de pe site ajung pe WhatsApp, clienții se programează singuri, iar cei mulțumiți primesc linkul de recenzie. Niciun client pierdut." path={path} schema={schema} ogImage="/assets/og/automatizari.jpg" preload="/video/automatizari.webp">
  <ServiceHero crumb="Automatizări" film="automatizari" title="Niciun client care ți-a scris nu mai rămâne fără răspuns" lead="Afacerile mici pierd cei mai mulți clienți după ce aceștia au scris deja: emailul citit a doua zi, telefonul nepreluat în timpul unei programări." />

  <Effects title="Ce se schimbă pentru tine" items={[
    { h: 'Cererea vine pe telefon', p: 'Ce completează omul pe site îți intră pe WhatsApp în aceeași secundă, iar el primește imediat un răspuns că te ocupi.' },
    { h: 'Programările se fac singure', p: 'Clientul își alege ora liberă din calendarul tău și primește reminder, ca să nu uite. Tu nu mai răspunzi la telefon în timp ce lucrezi.' },
    { h: 'Recenziile se adună', p: 'Cine a plecat mulțumit primește linkul de recenzie la momentul potrivit. Nota ta de pe Google crește fără să ceri tu.' },
  ]} />

  <Steps title="Cum lucrez" items={[
    { when: 'Ziua 1', h: 'Discuție de 20 de minute', p: 'Îmi spui cum vin acum cererile și unde se pierd. Alegem una sau două automatizări, nu zece.' },
    { when: 'Zilele 2–7', h: 'Construcție și test', p: 'Construiesc fluxul și îl testez cu cereri de probă, pe telefonul tău.' },
    { when: 'La predare', h: 'Îți arăt tot', p: 'Unde vezi cererile, cum schimbi un mesaj. În primele 30 de zile, orice ajustare e inclusă.' },
  ]} />

  <PriceLine anchor="automatizari" />
  <Faq items={FAQ} title="Întrebări despre automatizări" />
  <EndCta message="Bună, Alex! Pierd cereri de la clienți. Afacerea mea: " />
</Base>
