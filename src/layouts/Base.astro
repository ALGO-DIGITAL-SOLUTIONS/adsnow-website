---
import '../styles/site.css';
import { SITE, PREVIEW, GA_ID, CONTACT, COMPANY, NAV, SERVICES, BUSINESS_ID, WA_DEFAULT } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object[];
  ogImage?: string;
  preload?: string;
  preloadMobile?: string;
  dark?: boolean; // pagina începe cu un hero închis la culoare: meniul e alb peste el
}
const { title, description, path, schema = [], ogImage = '/assets/og-image.jpg', preload, preloadMobile, dark = true } = Astro.props;
const canonical = `${SITE}${path === '/' ? '/' : path}`;

const business = {
  '@type': 'ProfessionalService',
  '@id': BUSINESS_ID,
  name: 'ADSNOW',
  legalName: COMPANY.name,
  url: `${SITE}/`,
  telephone: CONTACT.phoneIntl,
  email: CONTACT.email,
  image: `${SITE}/assets/og-image.jpg`,
  logo: `${SITE}/assets/logo-512.png`,
  priceRange: '90–4.400 lei',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.street,
    addressLocality: CONTACT.city,
    postalCode: CONTACT.postalCode,
    addressCountry: 'RO',
  },
  areaServed: 'Brașov',
  sameAs: ['https://www.instagram.com/adsnow.ro/', 'https://www.facebook.com/adsnow.ro', 'https://www.tiktok.com/@adsnow.ro'],
};
const graph = { '@context': 'https://schema.org', '@graph': [business, ...schema] };
const isActive = (href: string) => href === path;
---
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{PREVIEW && <meta name="robots" content="noindex, nofollow"/>}
<meta name="theme-color" content="#16115E"/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="ro_RO"/>
<meta property="og:site_name" content="ADSNOW"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={`${SITE}${ogImage}`}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:image" content={`${SITE}${ogImage}`}/>
<link rel="icon" type="image/svg+xml" href="/assets/semn-adsnow.svg"/>
<link rel="icon" href="/favicon.ico" sizes="32x32"/>
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png"/>
<link rel="preload" href="/fonts/coolvetica.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/fonts/garet-book.woff2" as="font" type="font/woff2" crossorigin/>
{preload && <link rel="preload" as="image" href={preload} fetchpriority="high" media={preloadMobile ? '(min-width: 761px)' : undefined}/>}
{preloadMobile && <link rel="preload" as="image" href={preloadMobile} fetchpriority="high" media="(max-width: 760px)"/>}
<script type="application/ld+json" set:html={JSON.stringify(graph)}/>
</head>
<body class:list={{ 'starts-dark': dark }}>
<a class="skip" href="#continut">Sari la conținut</a>

<header class="top" id="top">
  <a href="/" class="top-logo" aria-label="ADSNOW, prima pagină">
    <img src="/assets/logo-adsnow.svg" alt="" width="139" height="36" class="logo-dark"/>
    <img src="/assets/logo-adsnow-alb.svg" alt="" width="139" height="36" class="logo-light"/>
  </a>
  <nav class="top-nav" aria-label="Meniu">
    <ul>
      {NAV.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <a href={WA_DEFAULT} class="btn btn-coral top-cta" data-track="whatsapp" target="_blank" rel="noopener">Scrie-mi pe WhatsApp</a>
  <button class="top-menu" type="button" aria-expanded="false" aria-controls="meniu-mobil">
    <span class="sr-only">Deschide meniul</span><span></span><span></span>
  </button>
</header>

<div class="menu-sheet" id="meniu-mobil" hidden>
  <ul>
    <li><a href="/">Prima pagină</a></li>
    {NAV.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
  </ul>
  <a href={WA_DEFAULT} class="btn btn-coral" data-track="whatsapp" target="_blank" rel="noopener">Scrie-mi pe WhatsApp</a>
  <a href={`tel:${CONTACT.phoneIntl}`} class="menu-phone" data-track="telefon">{CONTACT.phone}</a>
</div>

<main id="continut">
  <slot />
</main>

<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <img src="/assets/logo-adsnow-alb.svg" alt="ADSNOW" width="139" height="36" loading="lazy"/>
      <p>Site-uri, Google Maps, video și automatizări pentru afaceri locale. Lucrez din Brașov, cu clienți din toată țara.</p>
    </div>
    <div>
      <h2 class="foot-h">Servicii</h2>
      <ul>{SERVICES.map((s) => <li><a href={s.href}>{s.nav}</a></li>)}<li><a href="/preturi">Prețuri</a></li><li><a href="/proiecte">Proiecte</a></li></ul>
    </div>
    <div>
      <h2 class="foot-h">Contact</h2>
      <ul>
        <li><a href={WA_DEFAULT} target="_blank" rel="noopener" data-track="whatsapp">WhatsApp</a></li>
        <li><a href={`tel:${CONTACT.phoneIntl}`} data-track="telefon">{CONTACT.phone}</a></li>
        <li><a href={`mailto:${CONTACT.email}`} data-track="email">{CONTACT.email}</a></li>
        <li>{CONTACT.street}, {CONTACT.city}</li>
      </ul>
    </div>
    <div>
      <h2 class="foot-h">Firma</h2>
      <ul>
        <li>{COMPANY.name}</li>
        <li>CUI {COMPANY.cui}</li>
        <li>Reg. Com. {COMPANY.reg}</li>
        <li>Neplătitoare de TVA</li>
      </ul>
    </div>
  </div>
  <div class="wrap foot-legal">
    <a href="/politica-confidentialitate">Politica de confidențialitate</a>
    <button type="button" class="linklike" id="cookie-settings">Setări cookie-uri</button>
    <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener">ANPC</a>
    <span>© {new Date().getFullYear()} ADSNOW</span>
  </div>
</footer>

<a href={WA_DEFAULT} class="wa-float" data-track="whatsapp" target="_blank" rel="noopener" aria-label="Scrie-mi pe WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.1-1.2 2.8 1.2 3.2 1.4 3.4 2.4 3.6 5.7 5c2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5s.3-1.4.2-1.5-.3-.2-.6-.3Z"/></svg>
</a>

<div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookie-uri" hidden>
  <p>Folosesc Google Analytics ca să văd ce pagini ajută oamenii. Pornește doar dacă ești de acord. <a href="/politica-confidentialitate">Detalii</a></p>
  <div class="consent-btns">
    <button type="button" class="btn btn-ghost-dark" data-consent="denied">Refuz</button>
    <button type="button" class="btn btn-indigo" data-consent="granted">Sunt de acord</button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
(function () {
  // Google Analytics se încarcă doar după acord. Până atunci nu pleacă nimic spre Google.
  var KEY = 'adsnow-consent';
  function loadGA() {
    if (window.__ga) return; window.__ga = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID; document.head.appendChild(s);
  }
  var box = document.getElementById('consent');
  var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
  if (saved === 'granted') loadGA(); else if (!saved) box.hidden = false;
  box.addEventListener('click', function (e) {
    var b = e.target.closest('[data-consent]'); if (!b) return;
    var v = b.getAttribute('data-consent');
    try { localStorage.setItem(KEY, v); } catch (e) {}
    box.hidden = true; if (v === 'granted') loadGA();
  });
  document.getElementById('cookie-settings').addEventListener('click', function () { box.hidden = false; });

  // Ce măsurăm: click pe WhatsApp, telefon, email și trimiterea formularului.
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-track]'); if (!a || typeof gtag !== 'function') return;
    gtag('event', 'contact_' + a.getAttribute('data-track'), { page: location.pathname });
  });
  window.adsnowLead = function () { if (typeof gtag === 'function') gtag('event', 'generate_lead', { page: location.pathname }); };

  // Meniul: alb peste hero-ul închis, apoi plin după scroll.
  var top = document.getElementById('top');
  var onScroll = function () { top.classList.toggle('solid', window.scrollY > 40); };
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  var btn = top.querySelector('.top-menu'), sheet = document.getElementById('meniu-mobil');
  btn.addEventListener('click', function () {
    var open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', open); sheet.hidden = !open; document.body.classList.toggle('menu-open', open);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !sheet.hidden) { btn.click(); btn.focus(); }
  });

  // Filmele de fundal: se încarcă doar când ajung aproape de ecran, se opresc când ies.
  // Pe telefon se ia varianta verticală; cine a cerut mișcare redusă vede doar posterul.
  var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var narrow = window.matchMedia('(max-width: 760px)').matches;
  var films = document.querySelectorAll('video[data-film]');
  if (!still && films.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var v = en.target;
        if (en.isIntersecting) {
          if (!v.src) { v.src = (narrow && v.dataset.v) ? v.dataset.v : v.dataset.film; }
          var p = v.play(); if (p && p.catch) p.catch(function () {});
        } else if (v.src) { v.pause(); }
      });
    }, { rootMargin: '200px 0px' });
    films.forEach(function (v) { io.observe(v); });
    // Filmul din capul paginii pornește imediat după încărcare, fără să aștepte observatorul.
    window.addEventListener('load', function () {
      document.querySelectorAll('video[data-now]').forEach(function (v) {
        if (!v.src) v.src = (narrow && v.dataset.v) ? v.dataset.v : v.dataset.film;
        var p = v.play(); if (p && p.catch) p.catch(function () {});
      });
    });
  }
})();
</script>
<slot name="scripts"/>
</body>
</html>
