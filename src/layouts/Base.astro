---
import '../styles/global.css';
import '../styles/v2.css';
import { SITE, PREVIEW, CONTACT, NAV, SERVICES } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object[];
  ogTitle?: string;
  preloadHero?: boolean;
}

const { title, description, path, schema = [], ogTitle, preloadHero = false } = Astro.props;
const canonical = `${SITE}${path === '/' ? '/' : path}`;
const graph = schema.length ? { '@context': 'https://schema.org', '@graph': schema } : null;
const isActive = (href: string) => href === path;
---
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="utf-8"/>
{!PREVIEW && (
  <>
    {/* Consent Mode v2: nimic nu se scrie în cookie-uri până nu acceptă vizitatorul. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var c = null; try { c = localStorage.getItem('adsnow-consent'); } catch(e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: c === 'granted' ? 'granted' : 'denied'
      });
      gtag('js', new Date());
      gtag('config', 'G-9NW9NYSJFF');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9NW9NYSJFF"></script>
  </>
)}
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="theme-color" content="#16115E"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta name="author" content="ADSNOW"/>
<meta name="robots" content={PREVIEW ? 'noindex, nofollow' : 'index, follow'}/>
<meta name="google-site-verification" content="AIO6Fm5UwWBUt9lcUYRM854dxAnYmcJtU6Bd47AzMcs"/>
<link rel="canonical" href={canonical}/>
<meta property="og:title" content={ogTitle ?? title}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={`${SITE}/assets/og-image.jpg`}/>
<meta property="og:locale" content="ro_RO"/>
<meta property="og:site_name" content="ADSNOW"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="geo.region" content="RO-BV"/>
<meta name="geo.placename" content="Brașov"/>
<link rel="preload" href="/fonts/coolvetica.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/fonts/garet-book.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="icon" type="image/svg+xml" href="/assets/semn-adsnow.svg"/>
<link rel="icon" href="/favicon.ico" sizes="32x32"/>
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png"/>
{preloadHero && (
  <>
    <link rel="preload" as="image" href="/assets/phone/albastruinfinit.webp" fetchpriority="high"/>
  </>
)}
{graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
<slot name="head" />
</head>
<body class={PREVIEW ? 'is-preview' : undefined}>
{PREVIEW && <div class="preview-bar">PREVIZUALIZARE v2 · nu e site-ul live</div>}

<nav id="navbar">
  <div class="nav-brand">
    <a href="/"><img src="/assets/logo-adsnow.svg" alt="ADSNOW" class="nav-logo" width="139" height="36"/></a>
    <span class="nav-tagline">Marketing rapid pentru afaceri locale</span>
  </div>
  <div class="nav-links">
    <div class="nav-drop">
      <button type="button" class:list={['nav-link', 'nav-drop-btn', { active: SERVICES.some((x) => x.href === path) }]} aria-expanded="false" aria-haspopup="true">Servicii <span aria-hidden="true">▾</span></button>
      <div class="nav-drop-panel">
        {SERVICES.map((x) => (
          <a href={x.href} class:list={['nav-drop-item', { active: isActive(x.href) }]}>
            <span class="nav-drop-title">{x.short}</span>
            <span class="nav-drop-meta">{x.price}</span>
          </a>
        ))}
        <a href="/preturi" class="nav-drop-all">Toate pachetele și prețurile →</a>
      </div>
    </div>
    {NAV.filter((n) => n.href !== '/#servicii').map((n) => <a href={n.href} class:list={['nav-link', { active: isActive(n.href) }]}>{n.label}</a>)}
    <a href="/audit-gratuit" class="nav-cta">Audit gratuit</a>
  </div>
  <button type="button" class="hamburger" id="hamburger" aria-label="Meniu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-overlay" id="navOverlay">
  <div class="ov-group">
    <span class="ov-label">Servicii</span>
    {SERVICES.map((x) => <a href={x.href} class:list={['ov-sub', { active: isActive(x.href) }]}>{x.short}<small>{x.price}</small></a>)}
  </div>
  <div class="ov-group">
    <a href="/" class:list={['ov-link', { active: path === '/' }]}>Acasă</a>
    {NAV.filter((n) => n.href !== '/#servicii').map((n) => <a href={n.href} class:list={['ov-link', { active: isActive(n.href) }]}>{n.label}</a>)}
  </div>
  <a href="/audit-gratuit" class="nav-cta ov-cta">Audit gratuit în 2 minute</a>
  <a href={CONTACT.whatsapp} class="ov-contact" target="_blank" rel="noopener">WhatsApp · {CONTACT.phone}</a>
</div>

<main>
  <slot />
</main>

<footer>
  <div class="footer-grid">
    <div class="footer-col">
      <img src="/assets/logo-adsnow-alb.svg" alt="ADSNOW" class="footer-logo" width="124" height="32" loading="lazy"/>
      <div class="footer-tagline">Agenție de marketing pentru afaceri locale, Brașov</div>
      <p class="footer-brand-text">Site-uri în 10 zile, SEO local și Google Maps, reels și automatizări. {CONTACT.street}, {CONTACT.city}. Tel: {CONTACT.phone}.</p>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Servicii</div>
      {SERVICES.map((s) => <a href={s.href}>{s.short}</a>)}
      <a href="/preturi">Pachete și prețuri</a>
      <a href="/proiecte">Proiecte</a>
      <a href="/promovare-pensiuni">Pentru pensiuni și cabane</a>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Contact</div>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
      <a href={CONTACT.gbp} target="_blank" rel="noopener">{CONTACT.city}, {CONTACT.street}</a>
      <a href="/audit-gratuit">Audit gratuit</a>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Social și legal</div>
      <a href="https://www.facebook.com/adsnow.ro" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.instagram.com/adsnow.ro/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.tiktok.com/@adsnow.ro" target="_blank" rel="noopener">TikTok</a>
      <a href={CONTACT.gbp} target="_blank" rel="noopener">Google Business</a>
      <a href="/politica-confidentialitate">Politică de Confidențialitate</a>
      <button type="button" class="link-btn" id="consentReopen">Setări cookie-uri</button>
      <a href="https://www.anpc.gov.ro/" target="_blank" rel="noopener">ANPC</a>
    </div>
  </div>
  <div class="footer-bar">
    <span class="footer-copy">&copy; 2026 ADSNOW (ALGO Digital Solutions SRL). Toate drepturile rezervate.</span>
  </div>
</footer>

<a href={`${CONTACT.whatsapp}?text=${encodeURIComponent('Bună, Alex! Am văzut site-ul ADSNOW și aș vrea să vorbim.')}`} class="wa-float" target="_blank" rel="noopener" aria-label="Scrie-mi pe WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.96 12.96 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.64c-2.02 0-4-.54-5.72-1.57l-.41-.24-3.97 1.04 1.06-3.87-.27-.4A10.6 10.6 0 0 1 5.4 16c0-5.87 4.77-10.64 10.64-10.64 5.86 0 10.6 4.77 10.6 10.64 0 5.86-4.74 10.64-10.6 10.64Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.21-.18-.32-.02-.5.14-.65.15-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66 0 1.57 1.14 3.09 1.3 3.3.16.21 2.25 3.43 5.44 4.81.76.33 1.35.52 1.81.67.76.24 1.46.2 2 .12.61-.09 1.89-.77 2.15-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z"/></svg>
  <span>Scrie-mi pe WhatsApp</span>
</a>

<div class="consent" id="consent" role="dialog" aria-label="Cookie-uri">
  <p>Folosim Google Analytics ca să vedem ce pagini sunt citite. Nu pornește decât dacă ești de acord. Detalii în <a href="/politica-confidentialitate">politica de confidențialitate</a>.</p>
  <div class="consent-actions">
    <button type="button" class="accept" data-consent="granted">Sunt de acord</button>
    <button type="button" data-consent="denied">Refuz</button>
  </div>
</div>

<script is:inline>
(function(){
  var navbar = document.getElementById('navbar');
  window.addEventListener('scroll', function(){
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  }, {passive:true});

  var hamburger = document.getElementById('hamburger');
  var overlay = document.getElementById('navOverlay');
  hamburger.addEventListener('click', function(){
    hamburger.classList.toggle('active');
    overlay.classList.toggle('open');
  });
  overlay.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      hamburger.classList.remove('active');
      overlay.classList.remove('open');
    });
  });

  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){ entry.target.classList.add('visible'); observer.unobserve(entry.target); }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.fade-in').forEach(function(el){ observer.observe(el); });

  function accordion(btnSel, itemSel){
    document.querySelectorAll(btnSel).forEach(function(btn){
      btn.addEventListener('click', function(){
        var item = this.closest(itemSel);
        var wasOpen = item.classList.contains('open');
        document.querySelectorAll(itemSel + '.open').forEach(function(i){
          i.classList.remove('open');
          i.querySelector(btnSel).setAttribute('aria-expanded','false');
        });
        if(!wasOpen){ item.classList.add('open'); this.setAttribute('aria-expanded','true'); }
      });
    });
  }
  var drop = document.querySelector('.nav-drop');
  if (drop) {
    var dbtn = drop.querySelector('.nav-drop-btn');
    dbtn.addEventListener('click', function(e){
      e.stopPropagation();
      var open = drop.classList.toggle('open');
      dbtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function(e){
      if (!drop.contains(e.target)) { drop.classList.remove('open'); dbtn.setAttribute('aria-expanded','false'); }
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') { drop.classList.remove('open'); dbtn.setAttribute('aria-expanded','false'); }
    });
  }

  accordion('.faq-question', '.faq-item');
  accordion('.service-toggle', '.service-card');

  // Consimțământ
  var box = document.getElementById('consent');
  var saved = null; try { saved = localStorage.getItem('adsnow-consent'); } catch(e) {}
  if(!saved) box.classList.add('show');
  box.querySelectorAll('[data-consent]').forEach(function(b){
    b.addEventListener('click', function(){
      var v = this.getAttribute('data-consent');
      try { localStorage.setItem('adsnow-consent', v); } catch(e) {}
      if(typeof gtag === 'function') gtag('consent', 'update', { analytics_storage: v });
      box.classList.remove('show');
    });
  });
  document.getElementById('consentReopen').addEventListener('click', function(){ box.classList.add('show'); });
})();
</script>
<slot name="scripts" />
</body>
</html>
