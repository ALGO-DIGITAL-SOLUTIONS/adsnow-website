---
import { CASE_STUDIES } from '../data/site';
interface Props { only?: string[]; detailed?: boolean }
const { only, detailed = false } = Astro.props;
const list = only ? CASE_STUDIES.filter((c) => only.includes(c.slug)) : CASE_STUDIES;
---
<div class:list={['case-grid', { detailed }]}>
  {list.map((c) => (
    <article class="case-card fade-in" id={detailed ? c.slug : undefined}>
      <span class="card-kicker">{c.client} · {c.service}</span>
      <div class="case-stat">{c.stat}</div>
      <div class="case-stat-label">{c.statLabel}</div>
      {detailed && (
        <>
          <p class="case-story">{c.story}</p>
          <ul>{c.facts.map((f) => <li>{f}</li>)}</ul>
          <a href={c.url} target="_blank" rel="noopener" class="portfolio-link">{c.url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')} →</a>
        </>
      )}
    </article>
  ))}
</div>
