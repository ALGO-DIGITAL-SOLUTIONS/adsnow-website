---
import { CONTACT } from '../data/site';
interface Props { title?: string; desc?: string; whatsappFirst?: boolean }
const {
  title = 'Hai să vedem ce ți-ar aduce clienți',
  desc = 'Îmi spui în 2 minute ce ai acum și ce vrei. A doua zi primești pe email ce aș face eu în locul tău, cu prețuri.',
  whatsappFirst = false,
} = Astro.props;
const audit = { h: 'Audit gratuit în 2 minute', p: 'Cinci întrebări, iar în 24 de ore primești pe email ce ai de făcut. Gratuit, fără obligații.', href: '/audit-gratuit', btn: 'Începe auditul →', ext: false };
const wa = { h: 'Scrie-mi pe WhatsApp', p: 'Ai o întrebare sau vrei să vorbim direct? Îți răspund eu.', href: CONTACT.whatsapp, btn: 'Scrie pe WhatsApp →', ext: true };
const cards = whatsappFirst ? [wa, audit] : [audit, wa];
---
<section id="cta-final" class="section-dark section-padding">
  <div class="container">
    <h2 class="section-title fade-in" style="color:var(--paper);">{title}</h2>
    <p class="section-desc fade-in">{desc}</p>
    <div class="cta-grid">
      {cards.map((c, i) => (
        <div class:list={['cta-card', 'fade-in', { 'primary-card': i === 0 }]}>
          <h3>{c.h}</h3>
          <p>{c.p}</p>
          <a href={c.href} class="btn-primary" {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}>{c.btn}</a>
        </div>
      ))}
    </div>
    <p class="cta-micro fade-in">Răspund personal în maxim 24h. Sau sună direct la <a href={`tel:${CONTACT.phoneIntl}`} style="color:var(--sky);text-decoration:underline;">{CONTACT.phone}</a>.</p>
  </div>
</section>
