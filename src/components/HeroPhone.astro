---
// Telefon cu site-uri reale ale clienților, care se derulează singure (doar CSS, fără JavaScript).
// Lângă el, două carduri cu dovezi: harta Google pentru Armour Glass și creșterea Albastru Infinit.
import { PHONE_SITES, MAPS_PACK } from '../data/site';
const us = MAPS_PACK.find((m) => m.us)!;
---
<div class="hp">
  <div class="hp-phone" aria-label="Site-uri făcute de ADSNOW, văzute pe telefon">
    <div class="hp-notch"></div>
    <div class="hp-screen">
      {PHONE_SITES.map((s, i) => (
        <img
          src={`/assets/phone/${s.id}.webp`}
          alt={`Site-ul ${s.name}, pe telefon`}
          width="520" height="4000"
          class="hp-shot" style={`--i:${i}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
      ))}
    </div>
  </div>

  <div class="hp-card hp-maps">
    <div class="hp-card-top"><span class="hp-pin" aria-hidden="true"></span>Google Maps · „parbrize brasov”</div>
    <div class="hp-row">
      <strong>{us.name}</strong>
      <span class="hp-stars">★★★★★</span>
    </div>
    <div class="hp-sub">{us.rating} din {us.reviews} recenzii · în primele 3 pe hartă</div>
  </div>

  <div class="hp-card hp-growth">
    <div class="hp-card-top">Albastru Infinit · Google</div>
    <div class="hp-big">2×</div>
    <div class="hp-sub">mai des în căutări,<br/>după 3 luni de SEO</div>
  </div>
</div>
