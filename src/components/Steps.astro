---
interface Props { title: string; lead?: string; items: { when: string; h: string; p: string }[]; mist?: boolean }
const { title, lead, items, mist = true } = Astro.props;
---
<section class:list={['sec', { 'sec-mist': mist }]}>
  <div class="wrap">
    <div class="sec-head">
      <h2>{title}</h2>
      {lead && <p class="lead muted">{lead}</p>}
    </div>
    <ol class="steps">
      {items.map((s) => <li><span class="when">{s.when}</span><div><h3>{s.h}</h3><p>{s.p}</p></div></li>)}
    </ol>
  </div>
</section>
