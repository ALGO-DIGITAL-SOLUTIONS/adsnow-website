---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Întrebări frecvente' } = Astro.props;
---
<section class="sec" id="intrebari">
  <div class="wrap narrow">
    <h2 class="sec-head">{title}</h2>
    <div class="faq">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p class="ans">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
